# BugTwin Environment Configuration Template
# Copy this file to .env and configure your keys

# OpenAI API Key (Required for AI Root-Cause Analysis, Test Synthesis, and Patching)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Custom OpenAI Base URL (e.g. for proxies or local LLMs)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Core Server Port
PORT=3000

# Showcase Demo Port
DEMO_PORT=5500
