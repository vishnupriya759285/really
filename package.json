{
  "name": "bugtwin",
  "version": "1.0.0",
  "description": "Turn hard-to-reproduce software bugs into deterministic regression tests with OpenAI-powered fixes.",
  "main": "dist/index.js",
  "bin": {
    "bugtwin": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/cli/index.js",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "debugging",
    "regression-testing",
    "ai-agent",
    "devin",
    "test-generation",
    "sanitized-traces",
    "sandbox"
  ],
  "author": "BugTwin Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "openai": "^4.56.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  }
}
